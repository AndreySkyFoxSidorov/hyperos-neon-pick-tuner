<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Declared but never requested: the status notification shows only if the user enables it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: lets the rear-screen mini tuner stay up while the main screen is off. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Compact tuner for the rear display. Exported so it can be started with
             adb shell am start -display 1 -n com.neontuner/.rear.RearActivity -->
        <activity
            android:name=".rear.RearActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/RearTheme"
            android:excludeFromRecents="true"
            android:taskAffinity="com.neontuner.rear"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density">
            <!-- HyperOS rear-display gate (ActivityStarterImpl.isShouldShowOnRearDisplay):
                 0 = never, 1 = allowed on the rear screen. Same key Xiaomi Camera uses. -->
            <meta-data android:name="miui.rear.policy" android:value="1" />
        </activity>

        <activity
            android:name=".rear.DisplayProbeActivity"
            android:exported="false"
            android:label="Display diagnostics" />

        <service
            android:name=".TunerService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
