<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#4400F0FF">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#2200F0FF" />
                    <stroke android:width="1.5dp" android:color="#FF00F0FF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#CC0B0820" />
                    <stroke android:width="1dp" android:color="#FF3A3470" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
