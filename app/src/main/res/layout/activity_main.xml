<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.neontuner.ui.TunerView
        android:id="@+id/tuner"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.25"
            android:shadowColor="@color/magenta"
            android:shadowRadius="18"
            android:text="@string/title"
            android:textColor="@color/magenta"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/a4Badge"
            style="@style/Chip"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/rearBadge"
            style="@style/Chip"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/rear_toggle"
            android:text="◧" />

        <TextView
            android:id="@+id/gear"
            style="@style/Chip"
            android:contentDescription="@string/settings"
            android:text="⚙" />
    </LinearLayout>

    <!-- instrument chips -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- settings sheet: fills the space between the bars; tapping outside the card closes it -->
    <FrameLayout
        android:id="@+id/panelHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/panel_bg"
            android:clickable="true"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@drawable/scroll_thumb">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="6dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <!-- header with close button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Header"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings" />

                    <TextView
                        android:id="@+id/closeBtn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/close_bg"
                        android:contentDescription="@string/close"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/magenta"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- INPUT -->
                <TextView style="@style/Section" android:text="@string/sec_input" />

                <Switch
                    android:id="@+id/autoGateSwitch"
                    style="@style/NeonSwitch"
                    android:layout_marginTop="2dp"
                    android:text="@string/auto_gate" />

                <TextView
                    android:id="@+id/gateLabel"
                    style="@style/Label"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/gate"
                    style="@style/NeonSeek"
                    android:max="70" />

                <ProgressBar
                    android:id="@+id/level"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:max="70"
                    android:progressBackgroundTint="#FF2A2550"
                    android:progressTint="@color/green" />

                <TextView
                    android:id="@+id/gateHint"
                    style="@style/Hint"
                    android:layout_marginTop="4dp" />

                <Switch
                    android:id="@+id/lowCutSwitch"
                    style="@style/NeonSwitch"
                    android:text="@string/low_cut" />

                <TextView
                    android:id="@+id/sensLabel"
                    style="@style/Label"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/sens"
                    style="@style/NeonSeek"
                    android:max="100" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/sens_hint" />

                <!-- PICK -->
                <TextView style="@style/Section" android:text="@string/sec_pick" />

                <TextView
                    android:id="@+id/smoothLabel"
                    style="@style/Label" />

                <SeekBar
                    android:id="@+id/smooth"
                    style="@style/NeonSeek"
                    android:max="100" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/smooth_hint" />

                <TextView
                    android:id="@+id/lerpLabel"
                    style="@style/Label"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/lerp"
                    style="@style/NeonSeek"
                    android:max="100" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/lerp_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/a4_ref" />

                    <TextView
                        android:id="@+id/a4Minus"
                        style="@style/Chip"
                        android:text="−" />

                    <TextView
                        android:id="@+id/a4Value"
                        style="@style/Label"
                        android:layout_width="72dp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/a4Plus"
                        style="@style/Chip"
                        android:text="+" />
                </LinearLayout>

                <!-- CHORDS -->
                <TextView style="@style/Section" android:text="@string/sec_chords" />

                <Switch
                    android:id="@+id/chordsSwitch"
                    style="@style/NeonSwitch"
                    android:layout_marginTop="2dp"
                    android:text="@string/chords_switch" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/chords_hint" />

                <!-- REAR SCREEN -->
                <TextView style="@style/Section" android:text="@string/sec_rear" />

                <Switch
                    android:id="@+id/rearSwitch"
                    style="@style/NeonSwitch"
                    android:layout_marginTop="2dp"
                    android:text="@string/rear_switch" />

                <Switch
                    android:id="@+id/insetSwitch"
                    style="@style/NeonSwitch"
                    android:text="@string/inset_switch" />

                <TextView
                    android:id="@+id/rearStatus"
                    style="@style/Hint"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/resetBtn"
                        style="@style/Chip"
                        android:layout_marginEnd="8dp"
                        android:text="@string/reset" />

                    <TextView
                        android:id="@+id/resetAllBtn"
                        style="@style/Chip"
                        android:text="@string/reset_all" />
                </LinearLayout>

                <TextView
                    android:id="@+id/probeBtn"
                    style="@style/Chip"
                    android:layout_marginTop="8dp"
                    android:text="@string/display_diag" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
