<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.neontuner.ui.TunerView
        android:id="@+id/tuner"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.25"
            android:shadowColor="@color/magenta"
            android:shadowRadius="18"
            android:text="@string/title"
            android:textColor="@color/magenta"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/a4Badge"
            style="@style/Chip"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/rearBadge"
            style="@style/Chip"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/rear_toggle"
            android:text="◧" />

        <TextView
            android:id="@+id/gear"
            style="@style/Chip"
            android:contentDescription="@string/settings"
            android:text="⚙" />
    </LinearLayout>

    <!-- bottom: instrument chips + settings panel -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ScrollView
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/panel_bg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- noise gate + live input level -->
                <TextView
                    android:id="@+id/gateLabel"
                    style="@style/Label" />

                <SeekBar
                    android:id="@+id/gate"
                    style="@style/NeonSeek"
                    android:max="70" />

                <ProgressBar
                    android:id="@+id/level"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:max="70"
                    android:progressBackgroundTint="#FF2A2550"
                    android:progressTint="@color/green" />

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="4dp"
                    android:text="@string/gate_hint" />

                <TextView
                    android:id="@+id/sensLabel"
                    style="@style/Label"
                    android:layout_marginTop="14dp" />

                <SeekBar
                    android:id="@+id/sens"
                    style="@style/NeonSeek"
                    android:max="100" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/sens_hint" />

                <TextView
                    android:id="@+id/smoothLabel"
                    style="@style/Label"
                    android:layout_marginTop="14dp" />

                <SeekBar
                    android:id="@+id/smooth"
                    style="@style/NeonSeek"
                    android:max="100" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/smooth_hint" />

                <TextView
                    android:id="@+id/lerpLabel"
                    style="@style/Label"
                    android:layout_marginTop="14dp" />

                <SeekBar
                    android:id="@+id/lerp"
                    style="@style/NeonSeek"
                    android:max="100" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/lerp_hint" />

                <Switch
                    android:id="@+id/lowCutSwitch"
                    style="@style/NeonSwitch"
                    android:text="@string/low_cut" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/a4_ref" />

                    <TextView
                        android:id="@+id/a4Minus"
                        style="@style/Chip"
                        android:text="−" />

                    <TextView
                        android:id="@+id/a4Value"
                        style="@style/Label"
                        android:layout_width="72dp"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/a4Plus"
                        style="@style/Chip"
                        android:text="+" />
                </LinearLayout>

                <Switch
                    android:id="@+id/rearSwitch"
                    style="@style/NeonSwitch"
                    android:text="@string/rear_switch" />

                <Switch
                    android:id="@+id/insetSwitch"
                    style="@style/NeonSwitch"
                    android:text="@string/inset_switch" />

                <TextView
                    android:id="@+id/rearStatus"
                    style="@style/Hint"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/resetBtn"
                        style="@style/Chip"
                        android:layout_marginEnd="8dp"
                        android:text="@string/reset" />

                    <TextView
                        android:id="@+id/probeBtn"
                        style="@style/Chip"
                        android:text="@string/display_diag" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
